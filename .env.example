# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# Docker Compose lo usa para configurar PostgreSQL, el backend y el frontend.

POSTGRES_DB=streaming_platform
POSTGRES_USER=streaming_user
POSTGRES_PASSWORD=streaming_local_password

# Secreto para firmar tokens JWT (obligatorio): genera uno con `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Administrador que se crea en el primer arranque del backend (si no existe ninguno)
ADMIN_EMAIL=admin@streaming.local
ADMIN_PASSWORD=

# Orígenes permitidos por CORS: frontend Docker (8080) y Vite en desarrollo (5173)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Límite de tamaño de archivos subidos (MB)
MAX_UPLOAD_SIZE_MB=50

# URL de Ant Media Server como la ve el navegador (al descomentar el servicio antmedia)
ANTMEDIA_BASE_URL=http://localhost:5080/LiveApp
