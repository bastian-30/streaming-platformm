# Entorno de desarrollo local (copia este archivo a .env y ajusta los valores)
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://streaming_user:streaming_local_password@localhost:5433/streaming_platform

# Secreto para firmar tokens JWT: genera uno con `openssl rand -base64 48`
# Obligatorio en producción
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Directorio y límite para archivos subidos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
BCRYPT_ROUNDS=10

# Administrador inicial (se crea en el arranque si no existe ninguno)
ADMIN_EMAIL=admin@streaming.local
ADMIN_PASSWORD=

# Ant Media Server (transmisiones en vivo)
ANTMEDIA_BASE_URL=http://localhost:5080/LiveApp
